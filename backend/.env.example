# 大模型配置（OpenAI 兼容接口，第一版用 DeepSeek 联调）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的Key
LLM_MODEL=deepseek-chat

# ========== 视觉模型配置（图片取词，v0.7 起）==========
# 💡 v0.9 起可直接在「⚙️ 设置」页的视觉模型卡片里配置，无需改这里、也无需重启。
# 本节只是 .env 方式，适用于首次启动前就想设好的场景。
#
# ⚠️ DeepSeek 官方 API 无视觉模型，需另配一家支持图片输入的服务。
# 只需填 LLM_VISION_MODEL 即可启用；下面两个不填时自动回落到上面的 LLM_BASE_URL / LLM_API_KEY。
# 改完重启后端生效。若图片取词用不上，整块留空即可，接口会返回明确的未配置提示。
#
# 常见服务示例（任选一家，按所用服务的文档核对地址与模型名）：
#   阿里云百炼 DashScope：
#       LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#       LLM_VISION_MODEL=qwen3-vl-plus   # 实测可用；qwen-vl-max 在该端点不存在
#   智谱 AI：
#       LLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#       LLM_VISION_MODEL=glm-4v
#   硅基流动 SiliconFlow：
#       LLM_VISION_BASE_URL=https://api.siliconflow.cn/v1
#       LLM_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
LLM_VISION_MODEL=qwen3-vl-plus
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_API_KEY=

