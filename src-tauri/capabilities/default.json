{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "词札桌面 App 默认能力：允许 spawn sidecar 二进制（cizha-backend）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/cizha-backend",
          "sidecar": true,
          "args": ["--host", "127.0.0.1", "--port", { "validator": "[0-9]+" }]
        }
      ]
    }
  ]
}
